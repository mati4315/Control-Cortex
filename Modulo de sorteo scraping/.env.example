PORT=3000
TZ=America/Argentina/Buenos_Aires
NODE_ENV=development

SCRAPER_URL=https://servicios.iafas.gov.ar/iafasextractos/
SCRAPER_TIMEOUT_MS=12000
SCRAPER_RETRIES=3
RATE_LIMIT_PER_MINUTE=100
CACHE_TTL_SECONDS=900

ENABLE_SCHEDULER=false
SCHEDULER_PATTERN=*/2 * * * *
ENABLE_WEBSOCKET=true

CORS_ORIGIN=http://localhost:8872,http://127.0.0.1:8872
DASHBOARD_ORIGIN=http://localhost:8872,http://127.0.0.1:8872
JWT_SECRET=
CRON_SECRET=
ADMIN_USERNAME=
# Genera el hash con: npm run hash:password -- "tu contraseña"
ADMIN_PASSWORD_HASH=
# MySQL remoto (opcional — espeja resultados a Hostinger)
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306
MYSQL_POOL_LIMIT=3
MYSQL_CONNECT_TIMEOUT=10000
