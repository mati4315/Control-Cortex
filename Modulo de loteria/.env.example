WS_URL=ws://localhost:688
WS_TOKEN=tu-token-secreto-generado

# Firebase (opcional si usas service-account.json en esta carpeta)
FIREBASE_SA_PATH=./service-account.json
FIREBASE_PROJECT_ID=cdeluar-ddefc

# Hosting FTP (para clonar avatar externo a tu hosting)
HOSTING_FTP_HOST=your-ftp-host
HOSTING_FTP_PORT=21
HOSTING_FTP_USER=your-ftp-user
HOSTING_FTP_PASSWORD=your-ftp-password
HOSTING_FTP_SECURE=false
HOSTING_FTP_BASE_PATH=/domains/bot.cdelu.io/public_html/images
HOSTING_PUBLIC_BASE_URL=https://bot.cdelu.io/images
